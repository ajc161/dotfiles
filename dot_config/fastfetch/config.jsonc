{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/cachyos-linux.png",
    // "position": "top",
    "width": 5,
    "height": 2,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "loadavg",
    "packages",
    "shell",
    "editor",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "btrfs",
    "localip",
    "wifi",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
