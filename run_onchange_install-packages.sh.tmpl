{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# Core packages required by dotfiles configurations
PACKAGES=(
  atuin
  aws-cli-v2
  bat
  dust
  eza
  fastfetch
  fd
  fluxcd
  ghostty
  git-delta
  github-cli
  gping
  helm
  hexyl
  jaq
  jq
  k9s
  kubectl
  lazydocker
  lazygit
  procs
  rage-encryption
  ripgrep
  rustic
  sd
  starship
  television
  yazi
  zed
  zellij
  zoxide
  zsh
  zsh-autosuggestions
  zsh-history-substring-search
  zsh-syntax-highlighting
)

# Optional packages (rich media previews for yazi, utilities)
OPTIONAL_PACKAGES=(
  7zip         # yazi: archive extraction and preview
  ffmpeg       # yazi: video thumbnail generation
  fzf          # yazi & shell: fuzzy finding
  imagemagick  # yazi: image and font preview
  poppler      # yazi: PDF preview
  resvg        # yazi: SVG preview
)

# Check which packages are missing before invoking package manager / sudo
missing_packages=()
for pkg in "${PACKAGES[@]}" "${OPTIONAL_PACKAGES[@]}"; do
  if ! pacman -Q "$pkg" &>/dev/null; then
    missing_packages+=("$pkg")
  fi
done

if [ ${#missing_packages[@]} -eq 0 ]; then
  echo "==> [dotfiles] All packages already installed."
  exit 0
fi

echo "==> [dotfiles] Installing missing packages: ${missing_packages[*]}"

if command -v paru &>/dev/null; then
  paru -S --needed --noconfirm "${missing_packages[@]}"
elif command -v pacman &>/dev/null; then
  sudo pacman -S --needed --noconfirm "${missing_packages[@]}"
else
  echo "Error: Neither paru nor pacman found." >&2
  exit 1
fi

echo "==> [dotfiles] All Linux packages are installed."

{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

if ! command -v brew &>/dev/null; then
  echo "Homebrew not found. Please install Homebrew first: https://brew.sh"
  exit 1
fi

# Core CLI formulae
BREW_FORMULAE=(
  atuin
  awscli
  bat
  dust
  eza
  fastfetch
  fd
  fluxcd/tap/flux
  gh
  git-delta
  gping
  helm
  hexyl
  jaq
  jq
  k9s
  kubernetes-cli
  lazydocker
  lazygit
  procs
  rage
  ripgrep
  rustic
  sd
  starship
  television
  yazi
  zellij
  zoxide
  zsh-autosuggestions
  zsh-history-substring-search
  zsh-syntax-highlighting
)

# Optional packages (rich media previews for yazi, utilities)
OPTIONAL_FORMULAE=(
  sevenzip     # yazi: archive extraction and preview
  ffmpeg       # yazi: video thumbnail generation
  fzf          # yazi & shell: fuzzy finding
  imagemagick  # yazi: image and font preview
  poppler      # yazi: PDF preview
  resvg        # yazi: SVG preview
)

# GUI Casks
BREW_CASKS=(
  ghostty
  zed
)

# Check missing formulae
missing_formulae=()
for pkg in "${BREW_FORMULAE[@]}" "${OPTIONAL_FORMULAE[@]}"; do
  name=$(basename "$pkg")
  if ! brew list "$name" &>/dev/null; then
    missing_formulae+=("$pkg")
  fi
done

# Check missing casks
missing_casks=()
for cask in "${BREW_CASKS[@]}"; do
  if ! brew list --cask "$cask" &>/dev/null; then
    missing_casks+=("$cask")
  fi
done

if [ ${#missing_formulae[@]} -eq 0 ] && [ ${#missing_casks[@]} -eq 0 ]; then
  echo "==> [dotfiles] All Homebrew packages already installed."
  exit 0
fi

if [ ${#missing_formulae[@]} -gt 0 ]; then
  echo "==> [dotfiles] Installing missing Homebrew formulae: ${missing_formulae[*]}"
  brew install "${missing_formulae[@]}"
fi

if [ ${#missing_casks[@]} -gt 0 ]; then
  echo "==> [dotfiles] Installing missing Homebrew casks: ${missing_casks[*]}"
  brew install --cask "${missing_casks[@]}"
fi

echo "==> [dotfiles] All macOS packages are installed."
{{ end -}}
